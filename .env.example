# ===== 复制本文件为 .env 后修改；.env 不进仓库 =====

# --- 数据库 ---
POSTGRES_USER=uav
POSTGRES_PASSWORD=uav_dev_pw_change_me
POSTGRES_DB=uav
POSTGRES_PORT=5432

# --- 服务端口 ---
API_PORT=8000
# 前端端口。⚠️ 5173 可能落在 Windows 保留端口段里（Hyper-V/WSL 动态占段，重启后可能变），
# 表现是 web 容器起不来：
#   bind: An attempt was made to access a socket in a way forbidden by its access permissions
# 查保留范围，换一个不在里面的端口即可：
#   netsh interface ipv4 show excludedportrange protocol=tcp
# 后端 CORS 已放行 localhost 任意端口，改这里不用动后端。
WEB_PORT=5173

# --- 后端密钥（生产必须换成随机长串：python -c "import secrets;print(secrets.token_urlsafe(48))"）---
SECRET_KEY=dev-only-change-me

# --- 是否开放自主注册 ---
# true（默认）：登录页可以自己注册，注册后直接是普通用户(user)
# false：注册接口返回 403 REGISTER_DISABLED，账户只能由管理员开
ALLOW_SELF_REGISTER=true

# --- 时区 ---
TZ=Asia/Shanghai

# --- 数据目录（相对项目根目录；数据集放这里，不进 git）---
DATA_DIR=./data
