# ===== 复制本文件为 .env 后修改；.env 不进仓库 =====

# --- 数据库 ---
POSTGRES_USER=uav
POSTGRES_PASSWORD=uav_dev_pw_change_me
POSTGRES_DB=uav
# 宿主端口用 15432，避开本机可能已装的 Postgres(5432)；容器内仍是 5432
POSTGRES_PORT=15432

# --- 服务端口 ---
# 宿主端口刻意放在 15k–18k 冷门区间，两个原因：
#   1. 8000 / 5173 是最常见的开发端口，容易被别的服务占；
#   2. Windows 的 Hyper-V/WSL 会**动态保留整段端口**（实测 5173 曾被
#      5142–5241 整段占掉，web 容器起不来，报
#      "bind: An attempt was made to access a socket in a way forbidden..."）。
# 查当前保留段：netsh interface ipv4 show excludedportrange protocol=tcp
# 容器内端口不变（8000/5173/5432），只改宿主映射，所以 e2e 等容器内脚本不用动。
API_PORT=17800
WEB_PORT=17880

# ⚠️ 改了 API_PORT 之后，还要同步改 frontend/app/config.js 里的 apiPort，
#    否则前端连不上后端。后端 CORS 已放行 localhost 任意端口，不用动后端。

# --- 后端密钥（生产必须换成随机长串：python -c "import secrets;print(secrets.token_urlsafe(48))"）---
SECRET_KEY=dev-only-change-me

# --- 是否开放自主注册 ---
# true（默认）：登录页可以自己注册，注册后直接是普通用户(user)
# false：注册接口返回 403 REGISTER_DISABLED，账户只能由管理员开
ALLOW_SELF_REGISTER=true

# --- 检测模型 ---
# stub         = 假框，模型还没好时把系统跑通用
# ultralytics  = 加载 ml/weights 下的真实权重（需要 GPU 版镜像，见 docker-dev.md）
# 注意：docker-compose.yml 里默认是 stub，开了这里才用真模型
DETECTOR_BACKEND=stub
# 推理设备："0" = 第一块 GPU；"cpu" = 纯 CPU
DETECT_DEVICE=0
# 半精度只在 GPU 上有意义（CPU 上必须 false）
DETECT_HALF=true
# 权重路径（容器内路径，对应宿主机 ml/weights/）
# IR_WEIGHTS=/app/ml/weights/ir_yolo11s_640.pt
# RGB_WEIGHTS=/app/ml/weights/rgb_yolo11s_640.pt

# --- 时区 ---
TZ=Asia/Shanghai

# --- 数据目录（相对项目根目录；数据集放这里，不进 git）---
DATA_DIR=./data
